{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lowpolyworks",
  "pages_build_output_dir": ".cloudflare-build/pages",
  "compatibility_date": "2026-11-01",
  "r2_buckets": [{"binding": "LARGE_ASSETS", "bucket_name": "lowpolyworks-large-assets"}],
  "env": {"preview": {"r2_buckets": [{"binding": "LARGE_ASSETS", "bucket_name": "lowpolyworks-large-assets"}]}}
}
